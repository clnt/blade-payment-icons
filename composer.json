{
    "name": "clntdev/blade-payment-icons",
    "description": "Laravel Blade components for SVG credit card and payment icons",
    "keywords": [
        "laravel",
        "blade",
        "blade-icons",
        "svg",
        "icons",
        "credit-card",
        "payment",
        "visa",
        "mastercard",
        "amex"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Matt Clinton",
            "email": "matt@mattc.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-icons": "^1.7",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "clntdev/coding-standards": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/var-dumper": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Clntdev\\BladePaymentIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clntdev\\BladePaymentIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clntdev\\BladePaymentIcons\\BladePaymentIconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/pest --log-junit=coverage/phpunit.junit.xml --coverage-cobertura=coverage/cobertura.xml --coverage"
        ],
        "test-all": ["@test-quality", "@test"],
        "test-quality": ["@phpcs"],
        "phpcs": "vendor/bin/phpcs ./src ./tests --runtime-set ignore_warnings_on_exit true --standard=./vendor/clntdev/coding-standards/phpcs.xml",
        "cbf": "vendor/bin/phpcbf ./src ./tests --standard=./vendor/clntdev/coding-standards/phpcs.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
